VITE_SITE_URL=
VITE_BUSINESS_EMAIL=
VITE_BUSINESS_PHONE=
VITE_BUSINESS_ADDRESS=
VITE_INSTAGRAM_URL=
VITE_PINTEREST_URL=
VITE_LINKEDIN_URL=
# Supabase account authentication: public client configuration only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Enable only AFTER configuring and verifying Google OAuth in Supabase.
VITE_GOOGLE_AUTH_ENABLED=false
# AI provider secrets belong exclusively in a server environment.
# Public Supabase values above enable account sign-in and the existing AI access flow.
# Everything below is SERVER ONLY. Never prefix these names with VITE_.
AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Exact browser origin, no trailing slash. Set your production HTTPS origin.
APP_ORIGIN=http://localhost:5173
AI_RETENTION_HOURS=24
AI_TIMEOUT_MS=120000
# Conservative budget reservation per attempt, NOT a provider price quote.
AI_RESERVATION_CENTS=100
# Random secret for the authenticated hourly deletion task.
CRON_SECRET=
