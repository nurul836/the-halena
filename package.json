{
  "name": "the-halena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run check:env && tsc -b && tsc -p tsconfig.server.json && vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "dev:api": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/dev-api.ts",
    "test": "node scripts/verify-phase2.mjs && node scripts/verify-phase3.mjs && node scripts/verify-phase4.mjs && node scripts/verify-phase5.mjs && node scripts/verify-phase6.mjs && node scripts/verify-phase7.mjs && node scripts/verify-phase8.mjs",
    "check:env": "node scripts/environment.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "check:security": "node scripts/security-check.mjs",
    "test:tryon": "node scripts/verify-tryon-repair.mjs",
    "test:materials": "node scripts/verify-material-readiness.mjs",
    "test:auth": "node scripts/verify-auth.mjs",
    "test:google-auth": "node scripts/verify-google-auth.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.1.0",
    "gsap": "^3.13.0",
    "lucide-react": "^0.511.0",
    "motion": "^12.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@napi-rs/canvas": "^1.1.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": "24.x"
  }
}
